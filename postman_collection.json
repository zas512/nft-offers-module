{
  "info": {
    "_postman_id": "8f3b21c4-7b98-4c92-a162-8f19da563d41",
    "name": "NFT Offers Module API",
    "description": "Comprehensive Postman collection for the NFT Offers Module API, covering Users, Collections, NFTs, Offers, Escrows, and Ledger.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "buyerId",
      "value": "65f1a1a1a1a1a1a1a1a1a101",
      "type": "string"
    },
    {
      "key": "sellerId",
      "value": "65f1a1a1a1a1a1a1a1a1a102",
      "type": "string"
    },
    {
      "key": "nftId",
      "value": "65f1a1a1a1a1a1a1a1a1a301",
      "type": "string"
    },
    {
      "key": "collectionId",
      "value": "65f1a1a1a1a1a1a1a1a1a201",
      "type": "string"
    },
    {
      "key": "offerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "escrowId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ledgerId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Offers",
      "item": [
        {
          "name": "Create Single Item Offer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set expiresAt dynamically to 24 hours from now in ISO format",
                  "const expiresAt = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString();",
                  "pm.variables.set('dynamicExpiresAt', expiresAt);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.offerId) {",
                  "        pm.collectionVariables.set('offerId', json.data.offerId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buyerId\": \"{{buyerId}}\",\n  \"nftId\": \"{{nftId}}\",\n  \"grossAmountGrams\": 50000,\n  \"expiresAt\": \"{{dynamicExpiresAt}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/offers",
              "host": ["{{baseUrl}}"],
              "path": ["offers"]
            },
            "description": "Creates a new single-item offer, placing the buyer's funds in escrow and recording initial ledger entries."
          }
        },
        {
          "name": "Get All Offers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/offers?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["offers"],
              "query": [
                {
                  "key": "status",
                  "value": "pending",
                  "description": "Optional: Filter by offer status (pending, accepted, rejected, cancelled, expired, invalidated)"
                },
                {
                  "key": "buyerId",
                  "value": "{{buyerId}}",
                  "disabled": true,
                  "description": "Optional: Filter by buyer ObjectId"
                },
                {
                  "key": "collectionId",
                  "value": "{{collectionId}}",
                  "disabled": true,
                  "description": "Optional: Filter by collection ObjectId"
                },
                {
                  "key": "nftId",
                  "value": "{{nftId}}",
                  "disabled": true,
                  "description": "Optional: Filter by NFT ObjectId"
                }
              ]
            },
            "description": "Fetches all offers with optional query filters (buyerId, collectionId, nftId, status)."
          }
        },
        {
          "name": "Get Offer by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/offers/{{offerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["offers", "{{offerId}}"]
            },
            "description": "Fetches a single offer by its ObjectId."
          }
        },
        {
          "name": "Accept Single Item Offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellerId\": \"{{sellerId}}\",\n  \"nftId\": \"{{nftId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/offers/{{offerId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["offers", "{{offerId}}", "accept"]
            },
            "description": "Accepts an offer, transfers NFT ownership to the buyer, settles escrow, calculates fees (platform & royalty), and credits net payout to the seller."
          }
        },
        {
          "name": "Reject Single Item Offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellerId\": \"{{sellerId}}\",\n  \"nftId\": \"{{nftId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/offers/{{offerId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["offers", "{{offerId}}", "reject"]
            },
            "description": "Rejects an offer, refunds the locked escrow balance back to the buyer, and logs refund ledger entries."
          }
        }
      ]
    },
