erDiagram
    users ||--o{ collections : "creates"
    users ||--o{ nfts : "owns"
    users ||--o{ offers : "places (buyerId)"
    users ||--o{ escrow_accounts : "funded by (buyerId)"
    users ||--o{ escrow_accounts : "receives (sellerId)"
    users ||--o{ escrow_accounts : "earns royalty (creatorId)"
    users ||--o{ ledger_entries : "audited under"

    collections ||--|{ nfts : "contains"
    collections ||--o{ offers : "targeted by"

    nfts ||--o{ offers : "targeted in items"

    offers ||--|| escrow_accounts : "1:1 backed by"

    escrow_accounts ||--|{ ledger_entries : "generates audit entries"

    users {
        ObjectId _id PK
        string name
        string walletAddress
        string telegramId
        int availableBalance
        date createdAt
        date updatedAt
    }

    collections {
        ObjectId _id PK
        string name
        ObjectId creatorId FK
        int platformFeeBps
        int royaltyFeeBps
        date createdAt
        date updatedAt
    }

    nfts {
        ObjectId _id PK
        ObjectId collectionId FK
        ObjectId ownerId FK
        int tokenId
        string name
        string status
        bool isLocked
        date createdAt
        date updatedAt
    }

    offers {
        ObjectId _id PK
        ObjectId buyerId FK
        ObjectId escrowId FK
        ObjectId collectionId FK
        string type
        int grossAmountGrams
        string status
        date expiresAt
        date createdAt
        date updatedAt
    }

    escrow_accounts {
        ObjectId _id PK
        ObjectId offerId FK
        ObjectId buyerId FK
        ObjectId sellerId FK
        int grossAmountGrams
        string status
        date createdAt
        date updatedAt
        date settledAt
    }

    ledger_entries {
        ObjectId _id PK
        ObjectId referenceId FK
        ObjectId userId FK
        string account
        string type
        string direction
        int amountGrams
        date createdAt
    }